{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtds-agent.local/schemas/component_graph_annotations.schema.json",
  "title": "Source-bound advisory component graph assertions",
  "description": "Every assertion provenance must include the exact current path and SHA-256 of its source definition and each definition target, including compatible_neighbors. Assertions are unverified declarations and cannot carry qualification or execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "field_assertions",
    "edge_assertions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "field_assertions": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "edge_assertions": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "source_sha256",
        "locator"
      ],
      "properties": {
        "source_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition_id",
        "field",
        "value",
        "scope",
        "provenance"
      ],
      "properties": {
        "definition_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "field": {
          "enum": [
            "category",
            "engineering_role",
            "port_semantics",
            "typical_use",
            "compatible_neighbors",
            "manual_references"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/provenance"
          },
          "maxItems": 8,
          "uniqueItems": true
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_definition_id",
        "target_kind",
        "target_id",
        "scope",
        "provenance"
      ],
      "properties": {
        "kind": {
          "enum": [
            "IS_A",
            "CONNECTS_TO",
            "REQUIRES",
            "ALTERNATIVE_TO",
            "USED_IN",
            "INITIALIZED_BY",
            "CONTROLLED_BY",
            "MEASURED_BY"
          ]
        },
        "source_definition_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "target_kind": {
          "enum": [
            "definition",
            "project",
            "concept"
          ]
        },
        "target_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/provenance"
          },
          "maxItems": 8,
          "uniqueItems": true
        }
      }
    }
  }
}
