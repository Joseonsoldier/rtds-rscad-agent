{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtds-agent.local/schemas/line_constants_request.schema.json",
  "title": "Read-only supplied scalar line constants comparison",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "input", "output", "generation_receipt", "provenance"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "profile_id": {"const": "tline_rlc_3phase_ohmic_v1"},
    "input": {"$ref": "#/$defs/file"},
    "output": {"$ref": "#/$defs/file"},
    "generation_receipt": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/file"}]},
    "provenance": {"type": "array", "minItems": 1, "maxItems": 8, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["source_path", "source_sha256", "locator"],
      "properties": {
        "source_path": {"type": "string", "minLength": 1, "maxLength": 4000},
        "source_sha256": {"$ref": "#/$defs/sha"},
        "locator": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    }}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {
      "path": {"type": "string", "minLength": 1, "maxLength": 4000},
      "sha256": {"$ref": "#/$defs/sha"}
    }}
  }
}
