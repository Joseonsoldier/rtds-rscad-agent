{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtds-agent.local/schemas/power_system_rulepacks.schema.json",
  "title": "Explicit optional power system mathematical rule packs",
  "description": "Source-bound caller-declared criteria only; no verified engineering applicability, official requirement, automatic repairs or execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "input_project_sha256",
    "packs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "input_project_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "packs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pack_id",
          "domain",
          "bindings",
          "rules"
        ],
        "properties": {
          "pack_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "domain": {
            "enum": [
              "source",
              "transformer",
              "line",
              "synchronous_machine",
              "induction_machine",
              "converter",
              "gfm",
              "gfl",
              "bess",
              "protection"
            ]
          },
          "bindings": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "$ref": "#/$defs/binding"
            }
          },
          "rules": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "$ref": "#/$defs/rule"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "context",
        "component_id",
        "component_type",
        "definition_sha256",
        "parameter",
        "expected_value",
        "origin",
        "quantity",
        "units",
        "basis",
        "pu_base",
        "selectors"
      ],
      "properties": {
        "binding_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "\\S"
        },
        "context": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "component_id": {
          "type": "integer",
          "minimum": 0
        },
        "component_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "definition_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "parameter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "expected_value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "origin": {
          "enum": [
            "stored",
            "definition_default"
          ]
        },
        "quantity": {
          "enum": [
            "voltage_ll_rms",
            "voltage_phase_rms",
            "voltage_dc",
            "current_rms",
            "current_dc",
            "frequency",
            "active_power",
            "reactive_power",
            "apparent_power",
            "resistance",
            "reactance",
            "impedance",
            "dimensionless",
            "time",
            "energy"
          ]
        },
        "units": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "\\S"
        },
        "basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "pu_base": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "units"
              ],
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "units": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "\\S"
                }
              }
            }
          ]
        },
        "selectors": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parameter",
              "expected_value"
            ],
            "properties": {
              "parameter": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "\\S"
              },
              "expected_value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "pattern": "\\S"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "units": {
                "enum": [
                  "pu",
                  "p.u.",
                  "p.u"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "pu_base": {
                "type": "object"
              }
            }
          },
          "else": {
            "properties": {
              "pu_base": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "check",
        "inputs",
        "limits",
        "source",
        "scope",
        "severity",
        "confidence",
        "assumptions"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "\\S"
        },
        "check": {
          "enum": [
            "positive_voltage",
            "positive_frequency",
            "nonnegative_frequency",
            "positive_rating",
            "positive_energy",
            "positive_leakage_reactance",
            "nonnegative_resistance",
            "nominal_voltage_match",
            "frequency_match",
            "rating_match",
            "turns_ratio",
            "rating_relationship",
            "current_limit_consistency",
            "time_coordination",
            "apparent_power_rating",
            "power_current_rating"
          ]
        },
        "inputs": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        },
        "source": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_path",
              "source_sha256",
              "locator"
            ],
            "properties": {
              "source_path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000,
                "pattern": "\\S"
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "locator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "pattern": "\\S"
              }
            }
          }
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "confidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level",
            "rationale"
          ],
          "properties": {
            "level": {
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "pattern": "\\S"
            }
          }
        },
        "assumptions": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4,
          "items": {
            "enum": [
              "declared_ac_operation",
              "balanced_three_phase_sinusoidal",
              "declared_design_criterion",
              "common_reference_basis"
            ]
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "check": {
                "const": "positive_voltage"
              }
            }
          },
          "then": {
            "properties": {
              "inputs": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value"
                ],
                "properties": {
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "pattern": "\\S"
                  }
                }
              },
              "limits": {
                "type": "object",
                "additionalProperties": false,
                "required": [],
                "properties": {}
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "check": {
                "const": "positive_frequency"
              }
            }
          },
          "then": {
            "properties": {
              "inputs": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value"
                ],
                "properties": {
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "pattern": "\\S"
                  }
                }
              },
              "limits": {
                "type": "object",
                "additionalProperties": false,
                "required": [],
                "properties": {}
              },
              "assumptions": {
                "contains": {
                  "const": "declared_ac_operation"
