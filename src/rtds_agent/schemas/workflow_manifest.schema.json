{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.rtds-agent/schemas/workflow-manifest-1.0.json",
  "title": "RTDS Expert Agent workflow manifest",
  "type": "object",
  "required": [
    "schema_version",
    "workflow_id",
    "created_at",
    "updated_at",
    "state",
    "project",
    "test_spec",
    "test_spec_sha256",
    "evidence",
    "standing_authorizations",
    "approval_requests",
    "approvals",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "created",
        "inspected",
        "grounded",
        "static_validated",
        "awaiting_compile_approval",
        "compile_approved",
        "compiled",
        "awaiting_offline_test_approval",
        "offline_test_approved",
        "offline_test_completed",
        "awaiting_runtime_approval",
        "runtime_approved",
        "runtime_completed",
        "verified",
        "failed",
        "blocked"
      ]
    },
    "test_spec_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "project": {
      "type": "object",
      "required": [
        "source_path",
        "source_sha256",
        "working_copy",
        "working_sha256",
        "working_root",
        "vendor_source_root"
      ],
      "properties": {
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "working_copy": {
          "type": "string",
          "minLength": 1
        },
        "working_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "working_root": {
          "type": "string",
          "minLength": 1
        },
        "vendor_source_root": {
          "type": "string",
          "minLength": 1
        },
        "input_files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": true
          }
        },
        "input_bundle_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "companion_discovery_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": true
    },
    "standing_authorizations": {
      "type": "array"
    },
    "approval_requests": {
      "type": "array"
    },
    "approvals": {
      "type": "array",
      "items": {
        "$ref": "approval.schema.json"
      }
    },
    "events": {
      "type": "array",
      "minItems": 1
    }
  },
  "additionalProperties": true
}
