{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtds-agent.local/schemas/compile_failure_corpus.schema.json",
  "title": "Source-bound Compile diagnostic corpus",
  "description": "Raw fixture references and expected parser output are separate. Synthetic and sanitized cases never establish native integration or exact component identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "description",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "evidence_kind",
          "format_id",
          "raw_ref",
          "expectations",
          "provenance",
          "sanitization",
          "limitations"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "evidence_kind": {
            "enum": [
              "synthetic_authored",
              "native_observed_private",
              "sanitized_native_derivative"
            ]
          },
          "format_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "raw_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "bytes",
              "encoding"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000,
                "pattern": "\\S"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1048576
              },
              "encoding": {
                "enum": [
                  "utf-8",
                  "utf-8-sig",
                  "ascii"
                ]
              }
            }
          },
          "expectations": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "categories",
              "component_mappings",
              "parser_coverage"
            ],
            "properties": {
              "categories": {
                "type": "array",
                "minItems": 0,
                "maxItems": 10000,
                "items": {
                  "enum": [
                    "model_structure",
                    "parameter",
                    "connection",
                    "component_definition",
                    "companion_file",
                    "compile_resource",
                    "rscad_api",
                    "runtime",
                    "unknown"
                  ]
                }
              },
              "component_mappings": {
                "type": "array",
                "minItems": 0,
                "maxItems": 10000,
                "items": {
                  "enum": [
                    "exact_context_uuid",
                    "ambiguous",
                    "unknown"
                  ]
                }
              },
              "parser_coverage": {
                "enum": [
                  "empty",
                  "complete",
                  "partial",
                  "unsupported"
                ]
              }
            }
          },
          "provenance": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_path",
                "source_sha256",
                "locator"
              ],
              "properties": {
                "source_path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000,
                  "pattern": "\\S"
                },
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "locator": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000,
                  "pattern": "\\S"
                }
              }
            }
          },
          "sanitization": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "original_source_sha256",
                  "transform_description"
                ],
                "properties": {
                  "original_source_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "transform_description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000,
                    "pattern": "\\S"
                  }
                }
              }
            ]
          },
          "limitations": {
            "type": "array",
            "minItems": 0,
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "\\S"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "evidence_kind": {
                  "const": "sanitized_native_derivative"
                }
              }
            },
            "then": {
              "properties": {
                "sanitization": {
                  "type": "object"
                }
              }
            },
            "else": {
              "properties": {
                "sanitization": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    }
  }
}
