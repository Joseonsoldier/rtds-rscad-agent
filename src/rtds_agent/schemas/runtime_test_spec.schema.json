{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.rtds-agent/schemas/runtime-test-spec-1.5.json",
  "title": "RSCAD Runtime control and signal-capture test specification",
  "type": "object",
  "required": [
    "test_id",
    "execution_mode",
    "runtime_required",
    "event",
    "runtime_controls",
    "runtime_capture",
    "measurement_channels",
    "output_requirements"
  ],
  "properties": {
    "test_id": {
      "type": "string",
      "minLength": 1
    },
    "execution_mode": {
      "enum": [
        "runtime_read_only_signal_capture",
        "runtime_control_and_signal_capture"
      ]
    },
    "runtime_required": {
      "const": true
    },
    "event": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "none"
        }
      },
      "additionalProperties": true
    },
    "runtime_controls": {
      "type": "object",
      "required": [
        "read_only_signal_capture",
        "runtime_parameter_writes",
        "hardware_io_changes",
        "rack_configuration_changes",
        "deployment_actions"
      ],
      "properties": {
        "read_only_signal_capture": {
          "const": true
        },
        "runtime_parameter_writes": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "action_id",
              "purpose",
              "object_uuid",
              "object_type",
              "object_name",
              "object_group",
              "object_desc",
              "object_subpage",
              "attribute",
              "expected_initial_value",
              "value",
              "apply_after_seconds",
              "restore_after_capture"
            ],
            "properties": {
              "action_id": {
                "type": "string",
                "minLength": 1
              },
              "purpose": {
                "enum": [
                  "switch_operation",
                  "slider_change",
                  "dial_change",
                  "runtime_parameter_write",
                  "lockfree_change"
                ]
              },
              "object_uuid": {
                "type": "integer",
                "minimum": 0
              },
              "object_type": {
                "enum": [
                  "switch",
                  "slider",
                  "dial",
                  "binary_switch",
                  "button",
                  "draft_variable"
                ]
              },
              "object_name": {
                "type": "string",
                "minLength": 1
              },
              "object_group": {
                "type": "string",
                "minLength": 1
              },
              "object_desc": {
                "type": "string",
                "minLength": 1
              },
              "object_subpage": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "description": "Exact live Runtime subpage name; never inferred from a saved VIEW-ID."
              },
              "attribute": {
                "enum": [
                  "position",
                  "value"
                ]
              },
              "expected_initial_value": {
                "type": "number"
              },
              "value": {
                "type": "number"
              },
              "apply_after_seconds": {
                "type": "number",
                "minimum": 0,
                "maximum": 30
              },
              "restore_after_capture": {
                "const": true
              },
              "phase": {
                "enum": [
                  "before_run",
                  "after_run"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "hardware_io_changes": {
          "type": "array",
          "maxItems": 0
        },
        "rack_configuration_changes": {
          "type": "array",
          "maxItems": 0
        },
        "deployment_actions": {
          "type": "array",
          "maxItems": 0
        }
      },
      "additionalProperties": false
    },
    "runtime_capture": {
      "type": "object",
      "required": [
        "warmup_seconds",
        "minimum_samples_per_channel"
      ],
      "properties": {
        "warmup_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 30
        },
        "minimum_samples_per_channel": {
          "type": "integer",
          "minimum": 1
        },
        "acquisition_mode": {
          "enum": [
            "legacy",
            "native_signal_arrays"
          ],
          "description": "Native arrays require explicit graph scope and source-bound units/sign/time metadata; no fallback samples."
        }
      },
      "additionalProperties": false
    },
    "loadflow_initialization": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "zero_impedance_threshold_pu": {
          "type": "number",
          "minimum": 1e-09,
          "maximum": 0.001
        },
        "flat_start": {
          "type": "boolean"
        },
        "method": {
          "enum": [
            "FAST_DECOUPLED",
            "NEWTON_RAPHSON",
            "GAUSSIAN"
          ]
        }
      },
      "additionalProperties": false,
      "description": "Legacy plan inspection only when enabled; live execution is refused before dispatch. The old timeout field is not an installed solver timeout.",
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "timeout_seconds",
              "zero_impedance_threshold_pu",
              "flat_start",
              "method"
            ]
          },
          "else": {
            "maxProperties": 1
          }
        }
      ]
    },
    "measurement_channels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "channel_id",
          "signal_path",
          "units"
        ],
        "properties": {
          "channel_id": {
            "type": "string",
            "minLength": 1
          },
          "signal_path": {
            "type": "string",
            "minLength": 1
          },
          "units": {
            "type": "string",
            "minLength": 1
          },
          "runtime_identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "object_uuid",
              "object_name",
              "object_subpage"
            ],
            "properties": {
              "object_uuid": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9999999999999999
              },
              "object_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "object_subpage": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          },
          "metadata_evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_sha256",
              "locator"
            ],
            "properties": {
              "source_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "locator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          },
          "time_basis": {
            "const": "simulator_time"
          },
          "sign_convention": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "pu_base": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          }
        },
        "additionalProperties": true
      }
    },
    "output_requirements": {
      "type": "object",
      "required": [
        "raw_numeric_data_required",
        "screenshot_only_pass_fail_forbidden"
      ],
      "properties": {
        "raw_numeric_data_required": {
          "const": true
        },
        "screenshot_only_pass_fail_forbidden": {
          "const": true
        }
      },
      "additionalProperties": true
    },
    "event_timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "mode", "clock_channel_id", "source_evidence", "actions"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "mode": {"enum": ["wall_clock_debug", "model_native"]},
        "clock_channel_id": {"oneOf": [{"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"}, {"type": "null"}]},
        "source_evidence": {
          "oneOf": [
            {"type": "null"},
            {"type": "object", "additionalProperties": false, "required": ["source_sha256", "locator"], "properties": {"source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "locator": {"type": "string", "minLength": 1, "maxLength": 1000}}}
          ]
        },
        "actions": {
          "type": "array", "minItems": 0, "maxItems": 128,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["action_id", "event_id", "transition", "target_id", "kind", "requested_simulator_time", "from_value", "to_value", "units", "observation"],
            "properties": {
              "action_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"},
              "event_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"},
              "transition": {"enum": ["apply", "clear"]},
              "target_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"},
              "kind": {"enum": ["fault", "clear_fault", "trip", "reclose", "reference_change", "operator_control"]},
              "requested_simulator_time": {"type": "number", "minimum": 0, "maximum": 30},
              "from_value": {"type": "number"}, "to_value": {"type": "number"},
              "units": {"type": "string", "minLength": 1, "maxLength": 500},
              "observation": {
                "oneOf": [
                  {"type": "null"},
                  {"type": "object", "additionalProperties": false, "required": ["action_id", "channel_id", "window_start_seconds", "window_end_seconds", "value_tolerance", "max_timing_error_seconds", "max_sample_gap_seconds"], "properties": {
                    "action_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"}, "channel_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"}, "window_start_seconds": {"type": "number", "minimum": 0, "maximum": 30}, "window_end_seconds": {"type": "number", "minimum": 0, "maximum": 30}, "value_tolerance": {"type": "number", "minimum": 0}, "max_timing_error_seconds": {"type": "number", "minimum": 0}, "max_sample_gap_seconds": {"type": "number", "exclusiveMinimum": 0}
                  }}
                ]
              }
            }
          }
        }
      },
      "allOf": [
        {"if": {"properties": {"mode": {"const": "model_native"}}}, "then": {"required": ["clock_channel_id", "source_evidence"], "properties": {"clock_channel_id": {"type": "string"}, "source_evidence": {"type": "object"}, "actions": {"minItems": 1, "items": {"properties": {"observation": {"type": "object"}}}}}}},
        {"if": {"properties": {"mode": {"const": "wall_clock_debug"}}}, "then": {"properties": {"clock_channel_id": {"type": "null"}, "source_evidence": {"type": "null"}, "actions": {"items": {"properties": {"observation": {"type": "null"}}}}}}}
      ]
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime_capture": {
            "required": [
              "acquisition_mode"
            ],
            "properties": {
              "acquisition_mode": {
                "const": "native_signal_arrays"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "measurement_channels": {
            "items": {
              "required": [
                "channel_id",
                "signal_path",
                "units",
                "sign_convention",
                "time_basis",
                "runtime_identity",
                "metadata_evidence"
              ]
            }
          },
          "runtime_capture": {
            "properties": {
              "minimum_samples_per_channel": {
                "minimum": 2,
                "maximum": 100000
              }
            }
          }
        }
      }
    }
  ]
}
