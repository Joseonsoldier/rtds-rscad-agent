{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtds-agent.local/schemas/line_authoring_request.schema.json",
  "title": "In-memory preview of the observed scalar three-phase TLI profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "source",
    "assumptions",
    "changes",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "profile_id": {
      "const": "tline_rlc_3phase_ohmic_v1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "assumptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ideally_transposed",
        "frequency_independent_bergeron"
      ],
      "properties": {
        "ideally_transposed": {
          "const": true
        },
        "frequency_independent_bergeron": {
          "const": true
        }
      }
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "expected",
          "value"
        ],
        "properties": {
          "field": {
            "enum": [
              "line_length_km",
              "frequency_hz",
              "r_positive_ohm_per_km",
              "r_zero_ohm_per_km",
              "x_positive_ohm_per_km",
              "x_zero_ohm_per_km",
              "xc_positive_megohm_km",
              "xc_zero_megohm_km"
            ]
          },
          "expected": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "value": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_path",
          "source_sha256",
          "locator"
        ],
        "properties": {
          "source_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
